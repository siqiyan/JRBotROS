<launch>
    <node pkg="tf2_ros" type="static_transform_publisher"
        name="base_link2base_footprint"
        args="0 0 0 0 0 0 base_link base_footprint"/>

    <node pkg="tf2_ros" type="static_transform_publisher"
        name="base_link2laser"
        args="0 0 0.0115 0 0 0 base_link laser"/>

    <node pkg="tf2_ros" type="static_transform_publisher"
        name="base_link2camera"
        args="0 0 0.022 0 0 0 base_link camera"/>
</launch>
